{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:personal-knowledge:exchange:2",
  "title": "Personal Knowledge Exchange v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "sources",
    "items"
  ],
  "properties": {
    "format": {
      "type": "string",
      "enum": [
        "personal-knowledge-exchange"
      ]
    },
    "version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "sources": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "excerpt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "chatgpt",
              "report",
              "inspiration",
              "website",
              "other"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "excerpt": {
            "type": "string",
            "maxLength": 100000
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          },
          "original_date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "date_note": {
            "type": "string",
            "maxLength": 300
          },
          "recorded_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "maxLength": 40
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "body",
          "content_type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "maxLength": 100000
          },
          "body_format": {
            "type": "string",
            "enum": [
              "plain",
              "html"
            ]
          },
          "epistemic": {
            "type": "string",
            "enum": [
              "reported_fact",
              "ai_inference",
              "user_judgment"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "inbox",
              "draft",
              "review",
              "archived"
            ]
          },
          "priority": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3
            ]
          },
          "original_date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "date_note": {
            "type": "string",
            "maxLength": 300
          },
          "questions": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "domains": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            }
          },
          "tags": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            }
          },
          "collections": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            }
          },
          "parent": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "references": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "quote"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "maxLength": 80
                },
                "quote": {
                  "type": "string",
                  "maxLength": 10000
                }
              }
            }
          },
          "recorded_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "maxLength": 40
          },
          "content_type": {
            "type": "string",
            "enum": [
              "note",
              "bookmark",
              "tool",
              "document",
              "block",
              "unspecified"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "tool_kind": {
            "type": "string",
            "enum": [
              "website",
              "online",
              "ai",
              "desktop",
              "custom",
              "other"
            ]
          },
          "primary_domain": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "kind"
        ],
        "properties": {
          "from": {
            "type": "string",
            "maxLength": 80
          },
          "to": {
            "type": "string",
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "enum": [
              "duplicate",
              "complement",
              "conflict",
              "revision",
              "parent",
              "reference",
              "dependency",
              "composition",
              "related"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "parent": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          }
        }
      }
    }
  }
}
