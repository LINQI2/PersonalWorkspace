{
  "name": "personal-knowledge",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "node app/server/index.js",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.js",
    "test:startup": "node tests/startup.js",
    "format": "prettier --write app tests vite.config.ts package.json tsconfig.json",
    "test:visual": "node tests/visual.js after",
    "test:browser:v11": "node tests/browser-v11.js",
    "test:browser:ai": "node tests/browser-ai.js",
    "test:browser:deepseek": "node tests/browser-ai.js --deepseek",
    "test:browser:v13": "node tests/browser-v13.js",
    "test:browser:settings": "node tests/browser-settings.js",
    "test:browser:v14": "node tests/browser-v14.js",
    "test:browser:v15": "node tests/browser-v15.js",
    "test:browser:v15b": "node tests/browser-v15b.js",
    "test:browser:v16": "node tests/browser-v16.js",
    "test:browser:v161": "node tests/browser-v161.js",
    "test:browser:v17": "node tests/browser-v17.js",
    "test:browser:v171": "node tests/browser-v171.js",
    "test:browser:v172": "node tests/browser-v172.js",
    "test:browser:v173": "node tests/browser-v173.js",
    "test:browser:v18": "node tests/browser-v18.js",
    "test:browser:v19": "node tests/browser-v19.js"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "adm-zip": "^0.6.1",
    "entities": "^8.0.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mind-elixir": "5.15.1",
    "multer": "^2.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
